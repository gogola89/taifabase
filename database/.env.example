# Taifabase Development Environment Configuration - EXAMPLE FILE
# ================================================================
# SECURITY WARNING: This is a template file. Copy to .env and customize.
# NEVER commit .env files with real credentials to version control!
#
# Security Engineer: Dr. Kenji Tanaka
# Date: 2025-10-04 (Day 2 Security Hardening)

# PostgreSQL Configuration
# SECURITY: Use strong, randomly generated passwords in production
POSTGRES_DB=taifabase_dev
POSTGRES_USER=taifabase_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD  # Generate: openssl rand -base64 32
POSTGRES_PORT=5433                              # External port (via PgBouncer)
POSTGRES_INTERNAL_PORT=5434                     # Direct PostgreSQL access (Day 2: changed from 5433)

# PgBouncer Configuration (Day 2: Connection Pooling)
PGBOUNCER_PORT=5433                             # Main database connection port

# Redis Configuration
# SECURITY: Use strong password for Redis
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD     # Generate: openssl rand -base64 32
REDIS_PORT=6379

# Database Administration Tools
# SECURITY: Change default admin passwords immediately
ADMINER_PORT=8080
PGADMIN_PORT=8081
PGADMIN_EMAIL=admin@taifabase.dev
PGADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD   # Generate: openssl rand -base64 32

# Web Server Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Monitoring and Metrics
# SECURITY: Protect monitoring endpoints in production
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD   # Generate: openssl rand -base64 32
POSTGRES_EXPORTER_PORT=9187

# Development Environment Settings
COMPOSE_PROJECT_NAME=taifabase
COMPOSE_FILE=docker-compose.yml

# Health Check Configuration
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_RETRIES=5

# Resource Limits (adjust based on your system)
POSTGRES_MEMORY_LIMIT=2G
POSTGRES_MEMORY_RESERVATION=512M
REDIS_MEMORY_LIMIT=512M
REDIS_MEMORY_RESERVATION=128M

# Development Mode Settings
DEVELOPMENT_MODE=true
DEBUG_LOGGING=true
AUTO_RELOAD=true

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# SSL/TLS Configuration (Day 2 Security Hardening)
# Certificates are auto-generated in database/config/ssl/
# See database/config/ssl/README.md for certificate generation
SSL_CERT_PATH=./config/ssl/server.crt
SSL_KEY_PATH=./config/ssl/server.key

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# Performance Tuning
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=16MB

# Networking Configuration
NETWORK_SUBNET=172.20.0.0/16
NETWORK_GATEWAY=172.20.0.1

# ================================================================
# SECURITY BEST PRACTICES (Day 2 Security Hardening)
# ================================================================
#
# 1. STRONG PASSWORDS:
#    Generate strong passwords using: openssl rand -base64 32
#    Never use default passwords in production
#
# 2. SECRETS MANAGEMENT:
#    - Development: Use .env file (excluded from git)
#    - Production: Use Docker Secrets, HashiCorp Vault, or cloud secrets manager
#
# 3. PASSWORD ROTATION:
#    - Rotate passwords every 90 days minimum
#    - Use different passwords for each service
#    - Never reuse passwords across environments
#
# 4. FILE PERMISSIONS:
#    Ensure .env file has restricted permissions:
#    chmod 600 .env
#
# 5. NEVER COMMIT:
#    - Real passwords or API keys
#    - SSL/TLS private keys (server.key)
#    - Production credentials
#    - Personal access tokens
#
# 6. AUDIT LOGGING:
#    Enable comprehensive audit logging in production
#    Monitor for unauthorized access attempts
#
# 7. TLS/SSL:
#    Always use SSL/TLS encryption for:
#    - Database connections (sslmode=require)
#    - API endpoints (HTTPS)
#    - Monitoring interfaces
#
# 8. COMPLIANCE:
#    This configuration supports:
#    - GDPR Article 32 (Security of Processing)
#    - SOC2 Type II controls
#    - PCI DSS encryption requirements
#
# ================================================================
# For production deployments, see:
# - security/compliance-framework.md
# - security/infrastructure-security-assessment.md
# ================================================================
